{
  "name": "mini-notes",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc -b && vite build",
    "test": "node --test tests/reliability.test.mjs",
    "check": "pnpm test && pnpm build",
    "android:sync": "pnpm build && cap sync android",
    "android:open": "cap open android",
    "android:build": "pnpm android:sync && cap build android",
    "cf:config": "node scripts/prepare-wrangler.mjs",
    "preview": "vite preview --host 127.0.0.1",
    "cf:dev": "pnpm db:migrate:local && pnpm build && wrangler dev",
    "cf:deploy": "pnpm build && pnpm cf:config && wrangler deploy --config .wrangler/deploy.wrangler.jsonc",
    "cf:release": "pnpm db:migrate && wrangler deploy --config .wrangler/deploy.wrangler.jsonc",
    "db:create": "wrangler d1 create mini_notes",
    "db:migrate": "pnpm cf:config && wrangler d1 migrations apply DB --remote --config .wrangler/deploy.wrangler.jsonc",
    "db:migrate:local": "wrangler d1 migrations apply DB --local"
  },
  "dependencies": {
    "@blocknote/core": "^0.51.4",
    "@blocknote/mantine": "^0.51.4",
    "@blocknote/react": "^0.51.4",
    "@capacitor/android": "^7.4.0",
    "@capacitor/core": "^7.4.0",
    "@mantine/core": "^9.4.1",
    "@mantine/hooks": "^9.4.1",
    "@tiptap/core": "^3.27.1",
    "@tiptap/pm": "^3.27.1",
    "clsx": "^2.1.1",
    "lucide-react": "^1.22.0",
    "mind-elixir": "6.0.0-next.4",
    "react": "^19.2.7",
    "react-dom": "^19.2.7"
  },
  "devDependencies": {
    "@capacitor/cli": "^7.4.0",
    "@cloudflare/workers-types": "^4.20260629.1",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.3",
    "typescript": "^6.0.3",
    "vite": "^8.1.0",
    "wrangler": "^4.105.0"
  }
}
